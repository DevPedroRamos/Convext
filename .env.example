# Copie estas variáveis para .env.local (nunca use NEXT_PUBLIC_)
SUPABASE_TOKEN=replace_with_personal_access_token
SUPABASE_DB_PASSWORD=replace_with_database_password
SUPABASE_PROJECT_ID=kfhxiljdzgwylruinrve

# Memória / contexto dos agentes (/api/memory/*)
# Chaves aceitas pela API (separe por vírgula; uma por agente ou projeto consumidor)
MEMORY_API_KEYS=replace_with_random_secret
# Cliente CLI (scripts/memory.mjs)
MEMORY_API_URL=http://localhost:8080
MEMORY_API_KEY=replace_with_one_of_the_keys_above
# Embeddings Workers AI (bge-m3). Sem estas variáveis a busca opera só no modo textual.
CLOUDFLARE_ACCOUNT_ID=replace_with_account_id
CLOUDFLARE_AI_TOKEN=replace_with_workers_ai_token
# /api/memory/ask e eval --answer
ANTHROPIC_API_KEY=replace_with_anthropic_key
MEMORY_MODEL=claude-opus-5-5
